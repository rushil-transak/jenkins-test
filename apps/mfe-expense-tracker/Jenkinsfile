// ─────────────────────────────────────────────────────────────────────────────
// Pipeline: @budget/mfe-expense-tracker  (apps/mfe-expense-tracker)
//
// Jenkins setup:
//   1. Create a "Multibranch Pipeline" job in Jenkins.
//   2. Set "Script Path" to:  apps/mfe-expense-tracker/Jenkinsfile
//   3. Point to your GitHub repo and add a webhook (or enable SCM polling).
//
// Trigger logic:
//   • Every push fires this job.
//   • Lint / Test / Build / Archive are SKIPPED unless files inside
//     apps/mfe-expense-tracker/** or packages/** changed.
//   • Manual ("Build Now") runs always execute all stages.
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent any

    tools {
        nodejs 'node-20'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        skipStagesAfterUnstable()
        disableConcurrentBuilds()
    }

    environment {
        APP            = 'mfe-expense-tracker'
        WORKSPACE_FLAG = '--workspace=apps/mfe-expense-tracker'
        CI             = 'true'
        GH_REPO        = 'rushil-transak/jenkins-test'
    }

    stages {

        // ── 0. Prepare ─────────────────────────────────────────────────────
        stage('Prepare') {
            steps {
                script {
                    env.STATUS_SHA = env.CHANGE_ID
                        ? sh(script: 'git rev-parse HEAD^1', returnStdout: true).trim()
                        : env.GIT_COMMIT
                }
            }
        }

        // ── 1. Install ─────────────────────────────────────────────────────
        stage('Install') {
            steps {
                sh 'npm ci --no-audit --no-fund'
            }
        }

        // ── 2. Lint ────────────────────────────────────────────────────────
        stage('Lint') {
            when {
                anyOf {
                    changeset 'apps/mfe-expense-tracker/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                sh "npm run lint ${env.WORKSPACE_FLAG}"
            }
        }

        // ── 3. Test ────────────────────────────────────────────────────────
        stage('Test') {
            when {
                anyOf {
                    changeset 'apps/mfe-expense-tracker/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                sh "npm run test ${env.WORKSPACE_FLAG}"
            }
            post {
                always {
                    junit(
                        testResults: 'apps/mfe-expense-tracker/test-results/junit.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        // ── 4. Build ───────────────────────────────────────────────────────
        stage('Build') {
            when {
                anyOf {
                    changeset 'apps/mfe-expense-tracker/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                sh "npm run build ${env.WORKSPACE_FLAG}"
            }
        }

        // ── 5. Archive ─────────────────────────────────────────────────────
        stage('Archive') {
            when {
                anyOf {
                    changeset 'apps/mfe-expense-tracker/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                archiveArtifacts(
                    artifacts: 'apps/mfe-expense-tracker/dist/**',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_PAT')]) {
                sh """
                    curl -s -X POST \
                      -H "Authorization: token \${GH_PAT}" \
                      -H "Content-Type: application/json" \
                      "https://api.github.com/repos/${env.GH_REPO}/statuses/${env.STATUS_SHA}" \
                      -d '{"state":"success","context":"jenkins/${env.APP}","description":"Pipeline passed","target_url":"${env.BUILD_URL}"}'
                """
            }
        }
        failure {
            withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_PAT')]) {
                sh """
                    curl -s -X POST \
                      -H "Authorization: token \${GH_PAT}" \
                      -H "Content-Type: application/json" \
                      "https://api.github.com/repos/${env.GH_REPO}/statuses/${env.STATUS_SHA}" \
                      -d '{"state":"failure","context":"jenkins/${env.APP}","description":"Pipeline failed","target_url":"${env.BUILD_URL}"}'
                """
            }
        }
        unstable {
            withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GH_USER', passwordVariable: 'GH_PAT')]) {
                sh """
                    curl -s -X POST \
                      -H "Authorization: token \${GH_PAT}" \
                      -H "Content-Type: application/json" \
                      "https://api.github.com/repos/${env.GH_REPO}/statuses/${env.STATUS_SHA}" \
                      -d '{"state":"failure","context":"jenkins/${env.APP}","description":"Tests unstable","target_url":"${env.BUILD_URL}"}'
                """
            }
        }
    }
}
