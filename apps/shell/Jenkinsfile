// ─────────────────────────────────────────────────────────────────────────────
// Pipeline: @budget/shell  (apps/shell)
//
// Jenkins setup:
//   1. Create a "Multibranch Pipeline" job in Jenkins.
//   2. Set "Script Path" to:  apps/shell/Jenkinsfile
//   3. Point to your GitHub repo and add a webhook (or enable SCM polling).
//
// Trigger logic:
//   • Every push fires this job.
//   • The Lint / Test / Build / Archive stages are guarded by `changeset`:
//     they are SKIPPED unless files inside apps/shell/** or packages/** changed.
//   • Manual ("Build Now") runs always execute all stages.
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent any

    tools {
        nodejs 'node-20'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        skipStagesAfterUnstable()
        disableConcurrentBuilds()
    }

    environment {
        APP       = 'shell'
        WORKSPACE_FLAG = '--workspace=apps/shell'
        CI        = 'true'
    }

    stages {

        // ── 1. Install ─────────────────────────────────────────────────────
        stage('Install') {
            steps {
                sh 'npm ci --no-audit --no-fund'
            }
        }

        // ── 2. Lint ────────────────────────────────────────────────────────
        stage('Lint') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                sh "npm run lint ${env.WORKSPACE_FLAG}"
            }
        }

        // ── 3. Test ────────────────────────────────────────────────────────
        stage('Test') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                sh "npm run test ${env.WORKSPACE_FLAG}"
            }
            post {
                always {
                    junit(
                        testResults: 'apps/shell/test-results/junit.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        // ── 4. Build ───────────────────────────────────────────────────────
        stage('Build') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                // NOTE: The shell's vite build does NOT require the remote MFE
                // servers to be running — remotes are loaded lazily at runtime.
                sh "npm run build ${env.WORKSPACE_FLAG}"
            }
        }

        // ── 5. Archive ─────────────────────────────────────────────────────
        stage('Archive') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                archiveArtifacts(
                    artifacts: 'apps/shell/dist/**',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            githubNotify(
                credentialsId: 'github-pat',
                status: 'SUCCESS',
                description: "${env.APP} pipeline passed",
                context: "jenkins/${env.APP}"
            )
        }
        failure {
            githubNotify(
                credentialsId: 'github-pat',
                status: 'FAILURE',
                description: "${env.APP} pipeline failed",
                context: "jenkins/${env.APP}"
            )
        }
        unstable {
            githubNotify(
                credentialsId: 'github-pat',
                status: 'FAILURE',
                description: "${env.APP} tests unstable",
                context: "jenkins/${env.APP}"
            )
        }
    }
}
