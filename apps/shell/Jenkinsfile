// ─────────────────────────────────────────────────────────────────────────────
// Pipeline: @budget/shell  (apps/shell)
//
// Jenkins setup:
//   1. Create a "Multibranch Pipeline" job in Jenkins.
//   2. Set "Script Path" to:  apps/shell/Jenkinsfile
//   3. Point to your GitHub repo and add a webhook (or enable SCM polling).
//
// Trigger logic:
//   • Every push fires this job.
//   • The Lint / Test / Build / Archive stages are guarded by `changeset`:
//     they are SKIPPED unless files inside apps/shell/** or packages/** changed.
//   • Manual ("Build Now") runs always execute all stages.
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent any

    tools {
        nodejs 'node-20'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        skipStagesAfterUnstable()
        disableConcurrentBuilds()
    }

    environment {
        APP            = 'shell'
        WORKSPACE_FLAG = '--workspace=apps/shell'
        CI             = 'true'
        GH_REPO        = 'rushil-transak/jenkins-test'
    }

    stages {

        // ── 0. Prepare ─────────────────────────────────────────────────────
        // Capture the correct SHA to post status to:
        //   • PR build  → HEAD^1 (the PR branch tip, not the local merge commit)
        //   • Branch build → GIT_COMMIT as-is
        stage('Prepare') {
            steps {
                script {
                    env.STATUS_SHA = env.CHANGE_ID
                        ? sh(script: 'git rev-parse HEAD^1', returnStdout: true).trim()
                        : env.GIT_COMMIT
                }
            }
        }

        // ── 1. Install ─────────────────────────────────────────────────────
        stage('Install') {
            steps {
                sh 'npm ci --no-audit --no-fund'
            }
        }

        // ── 2. Lint ────────────────────────────────────────────────────────
        stage('Lint') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                sh "npm run lint ${env.WORKSPACE_FLAG}"
            }
        }

        // ── 3. Test ────────────────────────────────────────────────────────
        stage('Test') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                sh "npm run test ${env.WORKSPACE_FLAG}"
            }
            post {
                always {
                    junit(
                        testResults: 'apps/shell/test-results/junit.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        // ── 4. Build ───────────────────────────────────────────────────────
        stage('Build') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                sh "npm run build ${env.WORKSPACE_FLAG}"
            }
        }

        // ── 5. Archive ─────────────────────────────────────────────────────
        stage('Archive') {
            when {
                anyOf {
                    changeset 'apps/shell/**'
                    changeset 'packages/**'
                    triggeredBy 'UserIdCause'
                    expression { currentBuild.changeSets.isEmpty() }
                    changeRequest()
                }
            }
            steps {
                archiveArtifacts(
                    artifacts: 'apps/shell/dist/**',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {
        success {
            publishChecks name: "jenkins/${env.APP}", summary: 'Pipeline passed'
        }
        failure {
            publishChecks name: "jenkins/${env.APP}", summary: 'Pipeline failed'
        }
        unstable {
            publishChecks name: "jenkins/${env.APP}", summary: 'Tests unstable'
        }
        always {
            cleanWs()
        }
    }
}
