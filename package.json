{
  "name": "budget-calculator-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:remotes": "turbo build --filter='./apps/mfe-*'",
    "start": "turbo build --filter='./apps/mfe-*' && concurrently \"turbo dev --filter='./apps/shell'\" \"turbo preview --filter='./apps/mfe-*'\"",
    "dev": "turbo dev",
    "preview": "turbo preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^8.2.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "turbo": "latest",
    "vitest": "^3.0.5"
  }
}
